# Copy to .env (kept out of git) and fill in, then run ./build.sh.

# The Mac to watch, as ssh reaches it.
REMOTE_HOST=my-mac.local

# Private key for that host. It must work without a passphrase prompt (ssh runs in BatchMode).
# Leave empty to use your ssh config and agent.
SSH_IDENTITY_FILE=~/.ssh/id_ed25519

# Your reverse-DNS app ID; it is also the `defaults` domain for overrides.
BUNDLE_ID=com.example.MacProMonitor

# Optional: environment variables of headless (-batchmode) Unity runs to show in the Doing column,
# space-separated, e.g. "CI_RUN_LEVEL CI_RUN_MODE" shows as "level 3 · mode fast".
UNITY_ENV_KEYS=

# Optional: codesign identity. Default: the first "Apple Development" identity in the keychain, else ad hoc.
CODESIGN_IDENTITY=
